# Salin file ini menjadi .env di root repo:
#   cp .env.example .env
# Semua nilai di bawah adalah nilai pengembangan, bukan kredensial nyata.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=visitflow
POSTGRES_PASSWORD=visitflow
POSTGRES_DB=visitflow
# Port host 5433 dipakai agar tidak bentrok dengan PostgreSQL lokal di 5432.
POSTGRES_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://visitflow:visitflow@localhost:5433/visitflow
# Ganti dengan string acak yang panjang bila dipakai di luar lingkungan lokal.
JWT_SECRET=dev-only-change-this-secret
JWT_EXPIRES_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# --- Tes backend (database terpisah) ---
TEST_DATABASE_URL=postgresql+psycopg2://visitflow:visitflow@localhost:5433/visitflow_test
